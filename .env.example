# ==============================================================================
# TELEGRAM AIRDROP & MINING HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your personal credentials.
# NEVER commit your actual .env file or .session files to Git!
# ==============================================================================

# Telegram API Credentials (Obtain from https://my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Telegram Account Information
TELEGRAM_PHONE=+1234567890
TELEGRAM_USER_ID=your_telegram_user_id
TELEGRAM_USERNAME=your_telegram_username

# Cryptocurrency Payout Wallet Addresses
TON_WALLET_ADDRESS=your_ton_wallet_address_here
BEP20_USDT_ADDRESS=your_bep20_usdt_address_here
TRX_WALLET_ADDRESS=your_tron_wallet_address_here
FAUCETPAY_EMAIL_OR_ADDRESS=your_faucetpay_email_here

# Automation & Runtime Configuration
CYCLE_INTERVAL_SECONDS=1800
CONCURRENCY_LIMIT=5
AUTO_WITHDRAWAL_ENABLED=true
